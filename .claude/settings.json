{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(python3 tools/roadmap.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git bisect *)",
      "Bash(git clone https://github.com/NeoForgeMDKs/MDK-1.21.1-ModDevGradle *)",
      "Bash(git -C * checkout 00b49d3f81a257858ca425792d59b9e5ca0f7e56)",
      "Bash(git worktree *)",
      "Bash(python3 tools/claims.py *)",
      "Bash(python3 -m unittest *)",
      "Bash(mkdir -p build/mc-src)",
      "Bash(unzip -q -o mod/build/moddev/artifacts/* -d build/mc-src)",
      "Bash(find ~/.gradle/caches/modules-2/files-2.1 *)",
      "Bash(javap *)",
      "Bash(shasum -a 256 *)",
      "Bash(df -h *)",
      "Bash(date *)",
      "Bash(rm -f .session.lock)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "mcp__github__pull_request_read",
      "mcp__github__get_commit",
      "mcp__github__list_commits"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --delete main*)",
      "Bash(git push * -d main*)",
      "Bash(git push * :main*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- .)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git restore .)",
      "Bash(git restore -- .)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)"
    ]
